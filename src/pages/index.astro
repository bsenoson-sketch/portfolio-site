---
// Phase 3: The "Professional" Code Logic
const projects = [
  {
    title: "Cloud-Sync Dashboard",
    stack: "Astro, SQL, Cloudflare",
    problem: "Data latency was causing 5-second delays in user updates.",
    solution: "Edge-cached the API responses using Cloudflare Workers, hitting <100ms latency.",
    link: "https://github.com/bsenoson-sketch/portfolio-site"
  }
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
		<title>Brainy Señoson | Portfolio</title>
		<style>
			body { font-family: sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 2rem; }
			.card { border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem; border-radius: 8px; }
			.contact-links { margin-top: 1rem; display: flex; gap: 20px; font-size: 1.1rem; }
			.contact-links a { text-decoration: none; color: #333; }
			.contact-links i { margin-right: 8px; color: #007bff; }
		</style>
	</head>
	<body>
		<h1>Brainy Señoson</h1>
		<p>Full-Stack Developer specializing in Web Design. I build high-performance digital solutions that solve complex user experience problems.</p>

		<section id="proof">
			<h2>Project Gallery</h2>
			{projects.map(p => (
				<div class="card">
					<h3>{p.title} <small><a href={p.link}>[GitHub]</a></small></h3>
					<p class="tech"><strong>Tech:</strong> {p.stack}</p>
					<p><strong>Problem:</strong> {p.problem}</p>
					<p><strong>Solution:</strong> {p.solution}</p>
				</div>
			))}
		</section>

		<section id="resume">
			<h2>Skills</h2>
			<ul>
				<li>Languages: TypeScript, SQL, HTML/CSS</li>
				<li>Frameworks: Astro, React, Node.js</li>
				<li>Cloud: Cloudflare Workers, Pages</li>
			</ul>
		</section>

		<section id="contact">
			<h2>Contact</h2>
			
			<div class="contact-links">
				<a href="mailto:bsenoson@gmail.com">
					<i class="fa-solid fa-envelope"></i> bsenoson@gmail.com
				</a>
				<a href="https://www.facebook.com/search/top?q=Brainy%20Villaluz%20Señoson" target="_blank">
					<i class="fa-brands fa-facebook"></i> Brainy Villaluz Señoson
				</a>
			</div>

			<hr />

			<form action="https://formspree.io/f/your-id" method="POST" style="margin-top: 20px;">
				<input name="email" type="email" placeholder="Your Email" required style="display:block; margin-bottom:10px; width:100%; padding:8px;" />
				<textarea name="message" placeholder="How can I help you?" style="display:block; margin-bottom:10px; width:100%; padding:8px; height:100px;"></textarea>
				<button type="submit" style="padding:10px 20px; background:#007bff; color:white; border:none; border-radius:4px; cursor:pointer;">Send Message</button>
			</form>
		</section>
	</body>
</html>